# ═══════════════════════════════════════════════════════
# ReviewAnalyzer 环境变量
# 本地开发: 所有地址指向 localhost
# Docker:    所有地址指向服务名 (postgres/redis/minio)
# ═══════════════════════════════════════════════════════

# ── 数据库 ──
# 本地: postgresql+asyncpg://review:review@localhost:5432/reviewanalyzer
DATABASE_URL=postgresql+asyncpg://review:review@postgres:5432/reviewanalyzer

# ── Redis / Celery ──
# 本地: redis://localhost:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── MinIO ──
# 本地: localhost:9000
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=review-analyzer

# ── AI 引擎 ──
CLI_ENGINE=claude
CLI_TIMEOUT=600
MAX_CONCURRENT_AGENTS=4

# ── 应用 ──
APP_ENV=production
LOG_LEVEL=info
